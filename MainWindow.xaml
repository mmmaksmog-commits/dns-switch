<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="14" CornerRadius="18" Background="#14161B" BorderBrush="#262A33" BorderThickness="1"
        TextElement.Foreground="#E8EAEE" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="13">
  <Border.Effect>
    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="Black"/>
  </Border.Effect>
  <Border.Resources><!--THEME--></Border.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
        <Border Width="20" Height="20" CornerRadius="6" Background="#2FB36E" Margin="0,0,10,0">
          <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="DNS Switch" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock Text="  by mysik" Foreground="#6E7584" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
        <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="16,4,16,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- текущий DNS -->
      <Border Background="#1C1F26" CornerRadius="14" Padding="16,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="CurrentIconBg" Width="42" Height="42" CornerRadius="21" Background="#1A2C24" Margin="0,0,14,0">
            <TextBlock x:Name="CurrentIcon" Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="#2FB36E"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Сейчас используется" Foreground="#8B92A0" FontSize="11.5"/>
            <TextBlock x:Name="CurrentName" Text="Определяю…" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="CurrentSub" Text="" Foreground="#8B92A0" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button x:Name="RefreshBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Обновить"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="4,18,0,10">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DNS-серверы" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="SpeedHint" Text="Нажми «Проверить», чтобы узнать, какой быстрее у тебя" Style="{StaticResource Hint}"/>
        </StackPanel>
        <Button x:Name="TestBtn" Style="{StaticResource SecondaryBtn}" Background="#1C1F26" HorizontalAlignment="Right"
                VerticalAlignment="Center" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="TestBtnText" Text="Проверить" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
        <StackPanel Margin="0,0,6,0">
          <StackPanel x:Name="ProviderList"/>
          <Border x:Name="CustomBox" Background="#1C1F26" CornerRadius="12" Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Основной" Foreground="#8B92A0" FontSize="11.5" Margin="2,0,0,4"/>
                <TextBox x:Name="CustomPrimary" Style="{StaticResource InputBox}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Запасной (необязательно)" Foreground="#8B92A0" FontSize="11.5" Margin="2,0,0,4"/>
                <TextBox x:Name="CustomSecondary" Style="{StaticResource InputBox}"/>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="Шифрование DNS (DoH) в Windows 11 включается в «Параметры → Сеть и Интернет → свойства подключения → Назначение DNS-сервера» после выбора Cloudflare, Google или Quad9."
                     Style="{StaticResource Hint}" Margin="4,6,4,4"/>
          <TextBlock Style="{StaticResource Hint}" Margin="4,8,4,4">
            <Run Text="DNS Switch"/>
            <Run x:Name="Signature" Text="by mysik" Foreground="#2FB36E" FontWeight="SemiBold" Cursor="Hand"/>
          </TextBlock>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="FlushBtn" Style="{StaticResource SecondaryBtn}" Background="#1C1F26" ToolTip="Сбросить кеш DNS">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Сбросить кеш" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ApplyBtn" Grid.Column="2" Style="{StaticResource PrimaryBtn}">
          <TextBlock x:Name="ApplyText" Text="Применить" FontSize="14"/>
        </Button>
      </Grid>
    </Grid>

    <Border x:Name="Snack" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="20,0,20,22" Padding="16,11" CornerRadius="12" Background="#2A2E38" BorderBrush="#363B47" BorderThickness="1"
            Opacity="0" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
      </Border.Effect>
      <TextBlock x:Name="SnackText" Text="" TextWrapping="Wrap" MaxWidth="320"/>
    </Border>

    <Grid x:Name="Overlay" Grid.Row="0" Grid.RowSpan="3" Background="#B30B0C10" Visibility="Collapsed">
      <Border Width="330" Background="#1E2128" CornerRadius="16" Padding="20" BorderBrush="#2E333E" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" Text="" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" Text="" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DlgNo" Style="{StaticResource SecondaryBtn}" Background="#2A2E38" Content="Отмена"/>
            <Button x:Name="DlgYes" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="OK"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Border>
